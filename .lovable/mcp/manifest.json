{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://kzaeahjeqlihmxrfhjqd.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "universflow-mcp",
      "version": "0.1.0",
      "title": "Univers Flow MCP"
    },
    "tools": [
      {
        "name": "search_tracks",
        "title": "Search tracks",
        "description": "Search Univers Flow for songs by title or artist. Covers artist-uploaded releases and the live chart catalog.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Search text (song title or artist name)."
            },
            "limit": {
              "description": "Max results, default 10.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_trending",
        "title": "Get trending tracks",
        "description": "Return the current Univers Flow trending chart tracks.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max tracks, default 20.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "chart": {
              "description": "Chart type, default 'trending'.",
              "type": "string",
              "enum": [
                "trending",
                "viral"
              ]
            },
            "country": {
              "description": "ISO-3166 country code or GLOBAL (default).",
              "type": "string",
              "pattern": "^[A-Za-z]{2}$|^GLOBAL$"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_artist",
        "title": "Get artist profile",
        "description": "Fetch a Univers Flow artist public profile by stage name, with follower and play totals.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Artist stage name (case-insensitive, partial match allowed)."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
